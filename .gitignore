# Only Shader Mix, the shared overlay code and the candidate sources are versioned here;
# the standalone colorful-infinity / balatro-swirl projects stay local.
/*
!/.gitignore
!/README.md
!/README.en.md
!/install.sh
!/shader-mix/
!/common/
!/candidates/
!/docs/
!/omarchy/

# build output and large regenerable images
build/
*.saver
candidates/thumbs/
.DS_Store
candidates/xhs/frames/
candidates/xhs/multi/
candidates/xhs/multi_sheet.jpg
candidates/xhs/zoomtest/
candidates/xhs/metal/
candidates/xhs/src/op_user_*.json
